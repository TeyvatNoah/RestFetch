<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- 通用配置 -->
  <PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 包信息 -->
		<PackageId>RestFetch.SourceGenerator</PackageId>
		<Version>0.2.10</Version>
		<!-- <PackageIcon>TODO</PackageIcon> -->
		<Title>RestFetch.SourceGenerator</Title>
		<!-- 项目类型,DotnetTool,Dependency -->
		<PackageType>Analyzer</PackageType>
		<Description>RestFetch SourceGenerator</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageTags>RestFetch</PackageTags>

    <!-- output target -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- <TargetFramework>net11.0</TargetFramework> -->
    <OutputType>Library</OutputType>
    <!-- 输出exe,dll文件名 -->
    <!-- <AssemblyName>$(Exefile)</AssemblyName> -->
    <!-- 输出目录 -->
    <!-- <OutputPath>Test\</OutputPath> -->
    <!-- TODO 如果源生成器产物不作为运行时依赖(即源生成器的dll不会在项目运行时被用到,比如仅作为分析器)则应当开启下面配置 -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
		<!-- TODO 在构建时执行代码风格检查,对于依赖了源生成器的项目应该关闭否则导致源生成器生成的代码构建不通过 -->
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

		<!-- TODO 如果pack报错可能需要关闭包验证 -->
		<!-- <EnablePackageValidation>false</EnablePackageValidation> -->


		<!-- TODO for SourceGenerators -->
    <!-- https://github.com/dotnet/roslyn/issues/52017
		https://github.com/dotnet/sdk/issues/17775
		https://github.com/dotnet/roslyn/issues/49075
		https://github.com/NuGet/Home/issues/11725
		https://github.com/dotnet/roslyn/discussions/47517#discussioncomment-64145
		https://github.com/dotnet/roslyn-sdk/blob/0313c80ed950ac4f4eef11bb2e1c6d1009b328c4/samples/CSharp/SourceGenerators/SourceGeneratorSamples/SourceGeneratorSamples.csproj#L13-L30
		https://stackoverflow.com/a/75401340
		https://stackoverflow.com/questions/74915263/c-sharp-source-generator-filenotfoundexception-could-not-load-file-or-assembly -->
		<!-- <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths;GetProjectRefDllPath</GetTargetPathDependsOn> -->

    <NoWarn>$(NoWarn);CA1805,RS2000,RS2008,NU5128,NU5118</NoWarn>

    <!-- T4模板 -->
    <!-- <TransformOnBuild>True</TransformOnBuild>
    <TransformOutOfDateOnly>True</TransformOutOfDateOnly> -->

		<!-- 方便VS调试 -->
		<IsRoslynComponent>true</IsRoslynComponent>
  </PropertyGroup>

  <!-- Debug配置 -->
  <PropertyGroup Condition="'$(Configuration)'=='' Or '$(Configuration)'=='DEBUG' Or '$(Configuration)'=='Debug'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- pdb文件位置和名称
    <PdbFile>$(Exefile)</PdbFile> -->
  </PropertyGroup>

  <!-- Release配置 -->
  <PropertyGroup Condition="'$(Configuration)'=='RELEASE' Or '$(Configuration)'=='Release'">
    <!-- 生成引用程序集 -->
    <!-- <ProduceReferenceAssembly>true</ProduceReferenceAssembly> -->
    <!-- <ProduceOnlyReferenceAssembly>true</ProduceOnlyReferenceAssembly> -->

    <!-- 生成调试信息 -->
    <!-- pdb文件位置和名称 -->
    <!-- <PdbFile>$(Exefile)</PdbFile> -->

		<!-- 如果生成snupkg则会导致pack的时候寻找/lib但找不到而报错,所以需要embedded而不生成snupkg -->
		<DebugType>embedded</DebugType>
		<IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <Target Name="MSBuildLog" AfterTargets="Build">
    <Message Text="$(Arch)" />
    <Message Text="$(RID)" />
    <Message Text="$(Configuration)" />
  </Target>

  <!-- T4模板 -->
  <!-- <ItemGroup>
		<T4Transform Include="file.tt" />
		<Compile Update="file.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>file.tt</DependentUpon>
		</Compile>
	</ItemGroup> -->
  <ItemGroup>
		<Compile Remove="./*Attribute.cs" />
		<EmbeddedResource Include="./AfterResponseAttribute.cs" LogicalName="RestFetch.AfterResponseAttribute.cs" />
		<EmbeddedResource Include="./BaseAddressAttribute.cs" LogicalName="RestFetch.BaseAddressAttribute.cs" />
		<EmbeddedResource Include="./BeforeSendAttribute.cs" LogicalName="RestFetch.BeforeSendAttribute.cs" />
		<EmbeddedResource Include="./BodyAttribute.cs" LogicalName="RestFetch.BodyAttribute.cs" />
		<EmbeddedResource Include="./RetryAttribute.cs" LogicalName="RestFetch.RetryAttribute.cs" />
		<EmbeddedResource Include="./TimeoutAttribute.cs" LogicalName="RestFetch.TimeoutAttribute.cs" />
		<EmbeddedResource Include="./ExceptionFactoryAttribute.cs" LogicalName="RestFetch.ExceptionFactoryAttribute.cs" />
		<EmbeddedResource Include="./HeaderAttribute.cs" LogicalName="RestFetch.HeaderAttribute.cs" />
		<EmbeddedResource Include="./HttpClientProxyAttribute.cs" LogicalName="RestFetch.HttpClientProxyAttribute.cs" />
		<EmbeddedResource Include="./HttpMethodAttribute.cs" LogicalName="RestFetch.HttpMethodAttribute.cs" />
		<EmbeddedResource Include="./IdGeneratorAttribute.cs" LogicalName="RestFetch.IdGeneratorAttribute.cs" />
		<EmbeddedResource Include="./MetadataAttribute.cs" LogicalName="RestFetch.MetadataAttribute.cs" />
		<EmbeddedResource Include="./OnErrorAttribute.cs" LogicalName="RestFetch.OnErrorAttribute.cs" />
		<EmbeddedResource Include="./OnSseEventErrorAttribute.cs" LogicalName="RestFetch.OnSseEventErrorAttribute.cs" />
		<EmbeddedResource Include="./OnSuccessAttribute.cs" LogicalName="RestFetch.OnSuccessAttribute.cs" />
		<EmbeddedResource Include="./ParamAttribute.cs" LogicalName="RestFetch.ParamAttribute.cs" />
		<EmbeddedResource Include="./QueryAttribute.cs" LogicalName="RestFetch.QueryAttribute.cs" />
		<EmbeddedResource Include="./ResponseAttribute.cs" LogicalName="RestFetch.ResponseAttribute.cs" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="ZString" GeneratePathProperty="true" PrivateAssets="all" />
		<!-- dev dependency -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.6.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" VersionOverride="5.6.0" PrivateAssets="all" />
		<PackageReference Include="IndexRange" VersionOverride="1.1.1" PrivateAssets="all" />
		<PackageReference Include="Nullable" VersionOverride="1.3.1" PrivateAssets="all" />
		<PackageReference Include="IsExternalInit" VersionOverride="1.0.3" PrivateAssets="all" />
		<!-- <ProjectReference Include="../RestFetch.WebUtilities/RestFetch.WebUtilities.csproj" PrivateAssets="All" />
		<ProjectReference Include="../RestFetch.Common/RestFetch.Common.csproj" PrivateAssets="All" /> -->
	</ItemGroup>
	<!-- TODO
  <ItemGroup>
    <ProjectReference Include="..\RoslynHelper\RoslynHelper.csproj" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup> -->
	<ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
		<!-- for icon -->
		<!-- <None Include="images\icon.png" Pack="true" PackagePath="\"/> -->
		<None Include="$(PKGZString)\lib\netstandard2.0\ZString.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
	<!-- for source generator -->
	<Target Name="PackProjectAndRefDll" BeforeTargets="_GetPackageFiles">
		<!-- TODO
		<MSBuild Projects="..\RoslynHelper\RoslynHelper.csproj" Targets="GetTargetPath">
			<Output TaskParameter="TargetOutputs" ItemName="_RoslynHelper_OutputItem" />
		</MSBuild> -->
		<ItemGroup>
			<None Include="$(TargetDir)$(TargetName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
			<!-- TODO
			<None Include="@(_RoslynHelper_OutputItem)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" /> -->
		</ItemGroup>
	</Target>

	<Target Name="GetProjectRefDllPath" BeforeTargets="GenerateNuspec;GetTargetPath">
		<!-- TODO
		<MSBuild Projects="..\RoslynHelper\RoslynHelper.csproj" Targets="GetTargetPath">
			<Output TaskParameter="TargetOutputs" ItemName="_RoslynHelper_OutputItem" />
		</MSBuild> -->
		<ItemGroup>
			<!-- TODO
			<TargetPathWithTargetPlatformMoniker Include="@(_RoslynHelper_OutputItem)" IncludeRuntimeDependency="false" /> -->
			<TargetPathWithTargetPlatformMoniker Include="$(PKGZString)\lib\netstandard2.0\ZString.dll" IncludeRuntimeDependency="false" />
		</ItemGroup>
	</Target>

	<!-- 在build时把依赖项dll拷贝到输出目录方便其他项目收集dll -->
	<Target Name="CopySelectedDependenciesToOutput" AfterTargets="Build">
		<ItemGroup>
			<ExtraAnalyzerDlls Include="$(PKGZString)\lib\netstandard2.0\ZString.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(ExtraAnalyzerDlls)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
	</Target>
</Project>